{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "baseUrl": ".",
    "paths": {
      "@nextpress/core/*": ["../../packages/core/src/*"],
      "@nextpress/blocks": ["../../packages/blocks/src"],
      "@nextpress/blocks/*": ["../../packages/blocks/src/*"],
      "@nextpress/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "install"]
}
