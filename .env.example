# NextPress example environment
# Copy to .env and fill in. Never commit real credentials.

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/nextpress"

# ── Auth ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ── Public site URL ──
# Used to build absolute media URLs. Required for Instagram publishing, since
# Meta downloads media from the public internet.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Storage ──
# "local" (default) or "s3"
STORAGE_PROVIDER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# ── Scheduled jobs ──
# Shared by /api/cron/publish and /api/cron/instagram-sync.
CRON_SECRET=""

# ── On-demand revalidation ──
REVALIDATION_SECRET=""

# ── Instagram Posts plugin ──
# From your Meta app: Instagram product → API setup with Instagram login.
# The redirect URI must match the app's Valid OAuth Redirect URIs exactly.
# INSTAGRAM_APP_SECRET is server-side only and must never reach the browser.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/v1/plugins/instagram-post/oauth/callback"
