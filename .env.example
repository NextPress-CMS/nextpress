# NextPress example environment
# Copy to .env and fill in. Never commit real credentials.

# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/nextpress"

# ── Auth ──
# Session signing secret, 32+ random characters (openssl rand -hex 32).
# AUTH_SECRET and NEXTAUTH_SECRET are both accepted.
NEXTAUTH_SECRET=""
# Public origin of the app. Required outside Vercel unless AUTH_TRUST_HOST=true
# (only behind a reverse proxy you control that sets X-Forwarded-Host).
NEXTAUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST=true

# Optional OAuth sign-in: each provider is enabled only when BOTH are set.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ── Public site URL ──
# Used to build absolute media URLs. Required for Instagram publishing, since
# Meta downloads media from the public internet.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Storage ──
# "local" (default) or "s3". Use s3 on serverless/containers: local disk is
# not persistent there. With s3, bucket, region and both keys are required.
STORAGE_PROVIDER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
# S3_PUBLIC_URL=""

# ── Scheduled jobs ──
# Shared by /api/cron/publish and /api/cron/instagram-sync. Callers send
# "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this itself; see
# apps/web/vercel.json).
CRON_SECRET=""

# ── On-demand revalidation ──
REVALIDATION_SECRET=""

# ── Instagram Posts plugin ──
# From your Meta app: Instagram product → API setup with Instagram login.
# The redirect URI must match the app's Valid OAuth Redirect URIs exactly.
# INSTAGRAM_APP_SECRET is server-side only and must never reach the browser.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/v1/plugins/instagram-post/oauth/callback"

# ── Plugins ──
# Uploading a plugin zip runs its code on the server. Disabled in production
# unless set to true.
# ALLOW_PLUGIN_UPLOAD=false
# Where plugins live; defaults to <repo>/plugins. Set for standalone builds.
# NEXTPRESS_PLUGINS_DIR=""

# ── CORS ──
# Comma-separated origins allowed to call /api/v1 from a browser.
# ALLOWED_ORIGINS=""

# ── Incoming webhooks ──
# One secret per source; the source name is a-z, 0-9 and underscores.
# WEBHOOK_SECRET_<SOURCE>=""
